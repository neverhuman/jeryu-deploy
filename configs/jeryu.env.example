# jeryu.env.example — every environment variable `jeryu serve` reads.
#
# Copy to the file your service manager loads (the release unit reads
# ~/.config/jeryu/jeryu.env), fill in what your site needs, and restart the
# forge: every value is read at startup or cached on first use, so an edit
# takes effect only after a restart. docs/configuration.md says which settings
# a minimal forge and a production forge need, and how to check them.
#
# Rules of this file:
# - `NAME=` (empty) behaves exactly like leaving NAME unset; fill in a value or
#   leave it empty.
# - `# NAME=` (commented out) marks a setting whose EMPTY value is NOT the same
#   as unset and would break or weaken the forge. Uncomment it only together
#   with a real value.
# - Never put a secret inline here when a *_FILE / path setting exists. Keep
#   this file mode 600, owned by the user the forge runs as.
# - Logins, hosts and origins below are examples (example.com, 192.0.2.0/24);
#   jeryu ships no site identities of its own.
#
# The listen address, SPA directory and split manifests are command-line
# flags, not environment: `jeryu serve --bind 127.0.0.1:8787
# --split-manifest /etc/jeryu/family.toml` (see docs/configuration.md).
# crates/jeryu-api/tests/operator_env_reference.rs keeps this list in step
# with the code.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Durable data directory: repositories (git/), SQLite stores, bot signing key,
# bootstrap credentials. Optional. Precedence: --data-dir, then this, then
# $XDG_DATA_HOME/jeryu, then $HOME/.local/share/jeryu. A leading ~ expands.
# Empty is refused at startup ("data directory must not be empty").
# Example: /var/lib/jeryu
# JERYU_DATA_DIR=

# ---------------------------------------------------------------------------
# Public origin and the edge proxy
# ---------------------------------------------------------------------------

# Public origin people and clients reach the forge at: scheme + host, no path.
# Recommended in production. Used for absolute html_url links on /api/v3,
# jankurai/proof check links, the gh-setup command the capability manifest
# prints, and the Origin a cookie WebSocket upgrade must carry. Unset: links
# stay relative and WebSockets must be same-origin with the request's Host.
# Example: https://forge.example.com
JERYU_PRODUCTION_ORIGIN=

# Direct peers whose X-Forwarded-For is believed when computing a client's
# address for per-address rate limits (sign-up, bot routes, bad credentials).
# Required behind a reverse proxy. Format: exact IPv4/IPv6 addresses,
# comma-separated; no CIDR ranges, no ports (invalid entries are dropped
# silently). Default: none, so every request keys on the proxy's address and
# the forge logs one "jeryu-api proxy trust:" warning. A proxy on the same host
# connects from loopback. Example: 127.0.0.1,::1
JERYU_TRUSTED_PROXIES=

# host:port (NO scheme; http:// is prepended) of this forge, used as the origin
# for CI work the forge starts itself after a merge or ref update. Optional.
# Default: 127.0.0.1:8787, which is right when --bind is the default.
# Set it when you change --bind. Example: 127.0.0.1:9787
JERYU_BASE=

# Development only. 1/true/TRUE/yes/YES makes every loopback request without a
# forwarding header act as the admin `jeryu-admin` with no credential, and
# turns off Secure cookies. Never set it on a forge an edge proxy exposes: a
# same-host proxy connects from loopback. Default: off.
JERYU_WEB_TRUST_LOCAL=

# ---------------------------------------------------------------------------
# Bootstrap admin and signing keys
# ---------------------------------------------------------------------------

# Password for the built-in admin `jeryu-admin`. Optional. Unset: on first
# start the forge creates jeryu-admin with a one-time password written to
# <data_dir>/bootstrap-credentials.json (mode 600) and must be changed at first
# sign-in. Set: jeryu-admin is created or its password RESET to this value on
# EVERY start. Empty is applied as a password (and refused), so never leave it
# empty. Prefer unset; if you use it, use a systemd credential or a separate
# root-only EnvironmentFile, not this shared file.
# JERYU_BOOTSTRAP_ADMIN_PASSWORD=

# Path of the 32-byte key that signs bot access tokens. Optional. Default:
# <data_dir>/bot-signing.key, created mode 600 on first start; a group- or
# world-readable key is refused. Empty fails startup. Back it up with the data
# directory: a new key invalidates every issued bot token.
# Example: /var/lib/jeryu/bot-signing.key
# JERYU_BOT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Request limits and MCP
# ---------------------------------------------------------------------------

# Reads (GET/HEAD) per minute per credential before 429. Optional. Default:
# 600. A whole number; 0 disables the cap; anything unparsable uses the
# default. Example: 1200
JERYU_READ_RATE_LIMIT=

# Failed attempts per minute by one credential from one client address before
# that credential gets 429. Other credentials from the same address are not
# affected, so one job looping on a revoked token cannot lock out the rest.
# Optional. Default: 20. A whole number; 0 disables the cap; unparsable uses
# the default. Example: 40
JERYU_BAD_TOKEN_RATE_LIMIT=

# Failed credentials per minute from one client address, across all
# credentials, before that address gets 429: the backstop against a client
# trying many different credentials. Optional. Default: 200. A whole number;
# 0 disables the cap; unparsable uses the default. Example: 400
JERYU_BAD_TOKEN_IP_RATE_LIMIT=

# Direct peer addresses whose personal access tokens may use /mcp. Optional.
# Default: none (personal tokens are refused on /mcp; agent and bot tokens are
# unaffected). Format: single IPs, comma-separated; ranges and 0.0.0.0/:: are
# refused with a startup warning. Never list a proxy's address.
# Example: 192.0.2.10
JERYU_MCP_PERSONAL_TOKEN_PEERS=

# ---------------------------------------------------------------------------
# Mail (email verification and password reset) — docs/account-email.md
# All three of sender, base URL and one transport are needed; with any one
# missing the forge sends nothing and records each unsent message as a failed
# audit record. Blank values count as unset.
# ---------------------------------------------------------------------------

# Sender for the From header. Example: jeryu <no-reply@example.com>
JERYU_MAIL_FROM=

# Public origin the links in messages are built on (not guessed from --bind);
# a trailing / is dropped. Usually the same as JERYU_PRODUCTION_ORIGIN.
# Example: https://forge.example.com
JERYU_MAIL_BASE_URL=

# Transport 1: a sendmail-compatible command the message is piped to, split on
# whitespace (no shell quoting). Wins over JERYU_MAIL_SPOOL.
# Example: /usr/sbin/sendmail -t -i
JERYU_MAIL_SENDMAIL=

# Transport 2: a directory that receives one RFC 5322 .eml file per message
# (written as .tmp, then renamed), for a separate job to submit.
# Example: /var/spool/jeryu-mail
JERYU_MAIL_SPOOL=

# Optional: where replies go when the sender is not read by a person. A plain
# address; anything else is named at startup and ignored.
# Example: help@example.com
JERYU_MAIL_REPLY_TO=

# Optional: one line closing every branded message (at most 200 characters,
# no line breaks), linked to JERYU_MAIL_FOOTER_URL (https) when that is set.
# Example: Run by Example Co.
JERYU_MAIL_FOOTER=
# Example: https://example.com
JERYU_MAIL_FOOTER_URL=

# ---------------------------------------------------------------------------
# Sign-up — docs/account-email.md
# Closed by default: accounts are made by an administrator
# (POST /api/v1/admin/users) and everybody else joins a waitlist.
# ---------------------------------------------------------------------------

# Who may sign up. Optional. Default: closed. `closed` refuses both sign-up
# routes with 403 signup_closed; `email` opens sign-up that proves an email
# address first (needs mail, above). Any other value is named on the startup
# log and stays closed. Example: email
JERYU_SIGNUP=

# Where a person joins the waitlist while sign-up is closed: an absolute https
# URL, usually another site's registration form. Optional. Default: none, in
# which case the web app uses the forge's own POST /api/v1/waitlist. An invalid
# value is named on the startup log and ignored.
# Example: https://waitlist.example.com/join?from=forge
JERYU_WAITLIST_URL=

# Optional: also send each newly listed waitlist address to another system
# (one list across several products). An https URL, or http to loopback; the
# POST is signed with HMAC-SHA256 under the secret in the file below. Off
# when unset. See docs/account-email.md "Waitlist forwarding".
# Example: https://lists.example.com/api/integrations/waitlist
JERYU_WAITLIST_FORWARD_URL=
# A file (mode 600) holding the shared secret, at least 32 characters.
# Example: /etc/jeryu/waitlist-forward-secret
JERYU_WAITLIST_FORWARD_SECRET_FILE=
# The product slug sent with each address (default jeryu).
JERYU_WAITLIST_PRODUCT=

# ---------------------------------------------------------------------------
# Automation identities
# Logins of the accounts your automation runs as. jeryu has no defaults for
# any of these. Lists are comma-separated logins; blanks are dropped.
# ---------------------------------------------------------------------------

# The login that reviews pull requests: every pull request lists it as a
# pending reviewer until it reviews, and the people views treat it as a
# service account. Optional; unset: no reviewer is described.
# Example: review-bot
JERYU_REVIEW_IDENTITY=

# The login whose merges land approved pull requests (merge-queue status and
# grant-gap warnings). Optional; unset: no merger is described or checked.
# Example: merge-bot
JERYU_MERGE_IDENTITY=

# Further logins whose approvals count as automation rather than a person's
# (merge queue), and which the people views treat as service accounts.
# Optional; default none: every approval counts as a person's.
# Example: ci-bot,release-bot
JERYU_AUTOMATION_IDENTITIES=

# Logins that are the same principal, for author/approver independence checks.
# Optional; default none. Format: canonical=alias[,alias...], entries separated
# by ; or whitespace; case-insensitive, a leading @ is ignored.
# Example: alice=alice-laptop,alice2;review-bot=review-bot-2
JERYU_PRINCIPAL_ALIASES=

# Login the todoq shift pull requests are opened as. Optional; unset: opening
# a shift pull request is refused with this name. Example: shift-bot
JERYU_SHIFT_PR_AUTHOR=

# ---------------------------------------------------------------------------
# Who may report: CI, audits, deployments, runners, boards, events
# Each is a comma-separated login list with no default; unset means only
# global admins may do it (JERYU_DEPLOYERS: nobody).
# ---------------------------------------------------------------------------

# May post commit statuses and check runs without being admin (gate runners).
# Example: gate-bot
JERYU_CI_PUBLISHERS=

# Whose jankurai audit reports the forge treats as authoritative.
# Example: audit-bot
JERYU_JANKURAI_SCORERS=

# Admins who may record deployments and deployment statuses. Being admin is not
# enough: the login must be admin AND listed. Unset: nobody may record one.
# These logins default to service, preserving machine-held release credentials.
# An admin can mark a person human through PUT /api/v1/admin/users/<login>/kind.
# Other automation roles still enforce service; list machine deployers in
# JERYU_AUTOMATION_IDENTITIES to make their service kind unoverridable.
# Example: release-bot
JERYU_DEPLOYERS=

# May post gate-runner heartbeats (/runners). Example: gate-bot
JERYU_RUNNER_REPORTERS=

# May PUT release-board snapshots (/releases). Example: release-bot
JERYU_BOARD_REPORTERS=

# May post pipeline events (POST /api/v1/events). Example: ci-bot,review-bot
JERYU_EVENT_REPORTERS=

# May post todoq slot heartbeats (and nothing else). Example: shift-bot
JERYU_SHIFT_REPORTERS=

# May report agent presence for any repository. Example: presence-bot
JERYU_PRESENCE_REPORTERS=

# ---------------------------------------------------------------------------
# Quality gate (jankurai/proof)
# ---------------------------------------------------------------------------

# Make a failing or missing jankurai/proof block approval and merge on EVERY
# repository. Optional. On: 1, true, yes, on (anything else is off).
# Default: off (advisory). Example: 1
JERYU_AUDIT_ENFORCE_MERGE=

# Repositories the gate blocks on while it is not enforced forge-wide.
# Optional; default none. Format: owner/name or owner/*, separated by commas
# or whitespace; case-insensitive. Example: acme/api,acme-tools/*
JERYU_AUDIT_GATE_REPOS=

# ---------------------------------------------------------------------------
# Attention inbox and Flow
# ---------------------------------------------------------------------------

# Machine names the inbox prints in "run this on ..." instructions. Optional;
# blank or unset shows the role ("the release host"). Example: release-1
JERYU_RELEASE_HOST=
# Example: gate-1
JERYU_GATE_HOST=
# Example: forge-1
JERYU_FORGE_HOST=

# Days a draft pull request may sit idle before it becomes an inbox item.
# Optional. Default: 3. Positive whole number; anything else uses the default.
# Example: 7
JERYU_DRAFT_IDLE_DAYS=

# Minutes without a reviewer heartbeat (default 10) or without a review pass
# (default 15) before the inbox reports the reviewer offline. Positive whole
# numbers; anything else uses the default. Example: 20
JERYU_REVIEWER_HEARTBEAT_OFFLINE_MINUTES=
JERYU_REVIEWER_PASS_OFFLINE_MINUTES=

# Expected tool capacity per Flow station (GET /api/v1/flow/layout flags a
# station below it). Optional; unset: no expectation. A whole number. Empty or
# unparsable is reported as an invalid setting, so leave these commented out
# unless you set them. Example: 2
# JERYU_FLOW_EXPECTED_QUEUE=
# JERYU_FLOW_EXPECTED_WORK=
# JERYU_FLOW_EXPECTED_SHIFT=
# JERYU_FLOW_EXPECTED_REVIEW=
# JERYU_FLOW_EXPECTED_GATE=
# JERYU_FLOW_EXPECTED_MERGE=
# JERYU_FLOW_EXPECTED_PIN=
# JERYU_FLOW_EXPECTED_STAGE=
# JERYU_FLOW_EXPECTED_DEPLOY=

# ---------------------------------------------------------------------------
# GitHub mirror and pull-request import — docs/github-mirror.md
# Repositories enrol through the --split-manifest files, not here.
# ---------------------------------------------------------------------------

# host/owner pairs the mirror and importer may reach. Required for either to
# do anything; unset refuses every remote. Format: entries separated by
# commas or whitespace; https remotes only. Example: github.com/acme-oss
JERYU_MIRROR_REMOTE_ALLOWLIST=

# Kill switch: exactly 0 disables mirror pushes; anything else (or unset)
# leaves the mirror on for enrolled repositories. Example: 0
JERYU_GITHUB_PUSH=

# Minutes between mirror reconcile passes. Optional. Default: 10; 0 disables.
# Unparsable also disables. Example: 30
JERYU_GITHUB_MIRROR_RECONCILE_MINUTES=

# Arm the GitHub pull-request importer: exactly 1 turns it on; anything else
# leaves it off. Default: off. Read docs/github-mirror.md before arming: it
# runs contributed code on your gate. Example: 1
JERYU_GITHUB_PULL_IMPORT=

# Minutes between import polls. Optional. Default: 5; 0 disables. Unparsable
# also disables. Example: 10
JERYU_GITHUB_PULL_IMPORT_MINUTES=

# File holding the GitHub API token the importer uses (whitespace trimmed).
# Needed for the importer. Keep the file mode 600.
# Example: /etc/jeryu/secrets/github-api.token
JERYU_GITHUB_API_TOKEN_FILE=

# The same token inline. Prefer the _FILE form. This one wins whenever it is
# SET, and an empty value hides JERYU_GITHUB_API_TOKEN_FILE (no token at all),
# so keep it commented out unless you set a value.
# JERYU_GITHUB_API_TOKEN=

# Logins that may mark a pull request's origin (the importer's identity).
# Optional; unset: only admins. Comma/whitespace-separated. Example: import-bot
JERYU_PULL_IMPORTERS=

# Logins whose approval lets a contributed pull request merge. Optional;
# unset holds every contribution. Comma/whitespace-separated.
# Example: alice,bob
JERYU_PULL_MAINTAINERS=

# ---------------------------------------------------------------------------
# Tool-finder — docs/tool-finder.md
# ---------------------------------------------------------------------------

# Hours between scheduled duplicate-code scans. Optional. Default: 24;
# 0 disables; unparsable also disables. The effective value is logged at
# startup ("tool-finder: ..."). Example: 12
JERYU_TOOL_FINDER_SCAN_INTERVAL_HOURS=

# ---------------------------------------------------------------------------
# Codegraph index — docs/codegraph-oracle.md
# ---------------------------------------------------------------------------

# Hours between scheduled codegraph index refreshes, which is what the `code.*`
# MCP tools and the codegraph REST facade read. Optional. Default: 6;
# 0 disables the timer (a push to a repository's default branch still refreshes
# that repository); unparsable also disables. The effective value is logged at
# startup ("codegraph: ..."). Example: 12
JERYU_CODEGRAPH_REFRESH_INTERVAL_HOURS=

# ---------------------------------------------------------------------------
# Weekly Scorecard digest — docs/scorecard.md
# ---------------------------------------------------------------------------

# Hours between weekly Scorecard digests. Optional. Default: 168 (one week);
# 0 disables; unparsable also disables. The effective value and the target are
# logged at startup ("scorecard: weekly digest ..."). Example: 168
JERYU_SCORECARD_DIGEST_INTERVAL_HOURS=

# Where the digest is POSTed as JSON, as one absolute http or https URL.
# Optional, no default: with this empty the digest is recorded for the
# attention inbox and nothing is sent anywhere. Anything that is not an
# http(s) URL with a host is refused and logged rather than posted to.
# Example: https://hooks.example.com/jeryu/scorecard
JERYU_SCORECARD_DIGEST_WEBHOOK=

# ---------------------------------------------------------------------------
# Managed agent sessions
# On this release every managed session and agent run is refused until a
# verified Firecracker runner exists (docs/workcell.md); these only change
# which refusal is reported. Leave them empty.
# ---------------------------------------------------------------------------

# firecracker (default), auto, docker or native; anything else is reported as
# an invalid runtime. Example: firecracker
JERYU_AGENT_RUNTIME=

# Path of the docker binary (must be a file). Default: docker on PATH.
# Example: /usr/bin/docker
JERYU_DOCKER_BIN=

# Home directory whose agent CLI logins are copied into a session.
# Default: $HOME. Example: /home/jeryu
JERYU_AUTH_HOME=

# JERYU_AGENT_<ID>_BIN: the CLI an agent id launches (id upper-cased,
# non-alphanumerics become _). Default: a built-in path per id.
# Example: /usr/local/bin/codex
JERYU_AGENT_CODEX_BIN=
JERYU_AGENT_CLAUDE_BIN=

# ---------------------------------------------------------------------------
# Development tools — read by `jeryu dev pull-events`, never by `jeryu serve`
# ---------------------------------------------------------------------------

# Base URL of the forge `jeryu dev pull-events` copies events from, with
# GET-only requests, when --from is not given. Keep it in private operator
# config. Example: https://forge.example.com
# JERYU_REAL_DATA_URL=

# Path of the file holding the read token for that forge, when --token-file
# is not given. A leading ~ is expanded. Keep the file mode 600.
# Example: ~/.config/jeryu/real-data.token
# JERYU_REAL_DATA_TOKEN_FILE=

# ---------------------------------------------------------------------------
# Tests only — never set on a real forge
# ---------------------------------------------------------------------------

# Any non-empty value other than 0 makes CI simulated: on every push the forge
# records made-up check runs for .github/workflows jobs, which are not real
# runs and never count as merge evidence. Default: off. Leave empty.
JERYU_CI_MOCK=

# ---------------------------------------------------------------------------
# Process environment (normally provided by the service manager)
# Leave these to systemd/docker; an empty value would break the forge.
# ---------------------------------------------------------------------------

# Home of the service user: data-dir fallback ($HOME/.local/share/jeryu) and
# the agent auth home fallback. Example: /home/jeryu
# HOME=

# Data-dir fallback ($XDG_DATA_HOME/jeryu) when neither --data-dir nor
# JERYU_DATA_DIR is set; must be absolute. Example: /var/lib
# XDG_DATA_HOME=

# Where git, docker and the other programs the forge runs are found.
# Example: /usr/local/bin:/usr/bin:/bin
# PATH=

# Temporary directory for CI checkouts and scratch files.
# Default: /tmp. Example: /var/tmp/jeryu
# TMPDIR=

# The git binary the repository manager runs (read by the jeryu-gitd crate).
# Default: git on PATH. Example: /usr/bin/git
# GITD_GIT_BIN=
