#!/usr/bin/env bash
# Thin native-workflow reader. Authentication belongs entirely to gh.
set -u
export GH_PROMPT_DISABLED=1
usage() {
    echo 'Usage: gh jeryu pr {status|wait} NUMBER --repo OWNER/NAME --host https://HOST [--json]'
    echo '       wait also requires --target {ready|merged} --timeout SECONDS [--head SHA]'
}
invalid() { usage >&2; exit 2; }
[[ $# -ge 3 && $1 == pr && ($2 == status || $2 == wait) ]] || invalid
operation=$2 number=$3
shift 3
repo='' host='' target='' budget='' selected='' json=false
while [[ $# -gt 0 ]]; do
    case $1 in
        --json) json=true; shift ;;
        --repo|--host|--target|--timeout|--head)
            [[ $# -ge 2 ]] || invalid
            case $1 in
                --repo) repo=$2 ;; --host) host=${2%/} ;; --target) target=$2 ;;
                --timeout) budget=$2 ;; --head) selected=${2,,} ;;
            esac
            shift 2 ;;
        *) invalid ;;
    esac
done
[[ $number =~ ^[1-9][0-9]*$ && $repo =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]] || invalid
[[ /$repo/ != */../* && /$repo/ != */./* ]] || invalid
# An origin only: no userinfo, paths, query strings or fragments. HTTP is loopback only.
[[ $host =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?$ || $host =~ ^http://(localhost|127\.0\.0\.1)(:[0-9]+)?$ ]] || invalid
[[ -z $selected || $selected =~ ^([a-f0-9]{40}|[a-f0-9]{64})$ ]] || invalid
if [[ $operation == wait ]]; then
    [[ $target == ready || $target == merged ]] || invalid
    [[ $budget =~ ^[0-9]+([.][0-9]+)?$ ]] || invalid
    awk -v n="$budget" 'BEGIN { exit !(n > 0 && n <= 86400) }' || invalid
else
    [[ -z $target && -z $budget && -z $selected ]] || invalid
    budget=30
fi
for tool in gh jq timeout awk; do
    command -v "$tool" >/dev/null || { echo "Required tool unavailable: $tool" >&2; exit 1; }
done
[[ -r /proc/uptime ]] || { echo 'Linux monotonic clock unavailable' >&2; exit 1; }
umask 077
scratch=$(mktemp -d) || exit 1
child='' workflow=false
cleanup() { rm -rf -- "$scratch"; }
trap cleanup EXIT
emit() {
    if $json; then
        jq -n --arg result "$1" --arg selected "$selected" --slurpfile workflow "$scratch/workflow" \
            '{result:$result, selected_head_sha: (if $selected == "" then null else $selected end), workflow: ($workflow[0] // null)}'
    else
        echo "$1"
        [[ -z $selected ]] || echo "Selected head: $selected"
        if $workflow; then
            jq -r '
              def text: tostring | @json;
              "Head: " + .head_sha, "Current head: " + .current_head_sha,
              "Checks:", (.required_checks[] | "  \(.name|text): \(.state|text)"),
              "Other checks:", (.other_checks[] | "  \(.name|text): \((.conclusion // .status)|text)"),
              "Review: \(.review.approvals)/\(.review.required_approvals) approvals; \(.review.changes_requested) changes requested; \(.review.unresolved_threads) unresolved threads",
              "Blockers:", (.passport.blockers[] | "  \(.code|text): \(.message|text)"),
              "Next action: " + (.next_action.label|text)' "$scratch/workflow"
        fi
    fi
}
finish() { emit "$1"; exit "$2"; }
cancel() {
    if [[ -n $child ]]; then
        # timeout creates a process group, including gh and credential helpers.
        kill -KILL -- "-$child" 2>/dev/null || kill -KILL "$child" 2>/dev/null || :
        wait "$child" 2>/dev/null || :
    fi
    finish cancelled 130
}
trap cancel INT TERM
: > "$scratch/workflow"
clock_ms() { awk '{printf "%.0f\n", $1 * 1000}' /proc/uptime; }
start=$(clock_ms)
span=$(awk -v n="$budget" 'BEGIN { printf "%.0f", n * 1000 }')
deadline=$((start + span))
delay=1000
url="$host/api/v1/repos/$repo/pulls/$number"
while :; do
    remaining=$((deadline - $(clock_ms)))
    ((remaining > 0)) || finish timeout 3
    request_ms=$remaining
    ((request_ms <= 30000)) || request_ms=30000
    request_seconds=$(awk -v n="$request_ms" 'BEGIN {printf "%.3f", n / 1000}')
    timeout --signal=KILL "$request_seconds" gh api --method GET --include "$url" > "$scratch/response" 2>/dev/null &
    child=$!
    wait "$child" 2>/dev/null
    code=$?
    child=
    http=$(awk '/^HTTP\// {print $2; exit}' "$scratch/response")
    # A timed-out response may have headers but no complete JSON body.
    [[ $code != 124 && $code != 137 ]] || http=''
    case $http:$code in
        401:*|403:*|*:4) finish authentication_error 4 ;;
        408:*|429:*|5[0-9][0-9]:*|:*)
            [[ $operation == wait ]] || finish transient_error 1 ;;
        200:0)
            sed '1,/^\r\{0,1\}$/d' "$scratch/response" > "$scratch/body"
            if ! jq -e '
                .workflow | select(.schema == "pr_workflow/v1") |
                select(.head_sha | type == "string") |
                select(.head_sha | test("^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$")) |
                select(.current_head_sha | type == "string") |
                select(.current_head_sha | test("^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$")) |
                select(.outcome as $o | ["draft","checks_pending","checks_failed","review_needed","blocked","ready","closed","merged","head_changed"] | index($o)) |
                select((.required_checks|type) == "array" and (.other_checks|type) == "array" and
                       (.review|type) == "object" and (.passport.blockers|type) == "array" and
                       (.next_action|type) == "object")' "$scratch/body" > "$scratch/next" 2>/dev/null; then
                finish unsupported_response 1
            fi
            mv -- "$scratch/next" "$scratch/workflow"
            workflow=true
            head=$(jq -r .head_sha "$scratch/workflow")
            current=$(jq -r .current_head_sha "$scratch/workflow")
            outcome=$(jq -r .outcome "$scratch/workflow")
            [[ -n $selected ]] || selected=$head
            [[ $head == "$selected" && $current == "$selected" && $outcome != head_changed ]] || finish head_changed 5
            [[ $operation == wait ]] || finish "$outcome" 0
            (($(clock_ms) < deadline)) || finish timeout 3
            [[ $outcome != "$target" ]] || finish success 0
            case $outcome in
                checks_failed|blocked|closed|draft|merged) finish "$outcome" 2 ;;
            esac ;;
        *) finish request_failed 1 ;;
    esac
    remaining=$((deadline - $(clock_ms)))
    ((remaining > 0)) || finish timeout 3
    sleep_ms=$delay
    ((sleep_ms <= remaining)) || sleep_ms=$remaining
    seconds=$(awk -v n="$sleep_ms" 'BEGIN {printf "%.3f", n / 1000}')
    sleep "$seconds" &
    child=$!
    wait "$child"
    child=
    delay=$((delay * 2))
    ((delay <= 15000)) || delay=15000
done
