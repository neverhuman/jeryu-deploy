#!/usr/bin/env python3
"""Read the forge's head-bound workflow through gh's existing credentials."""
import argparse
import json
import math
import os
import re
import signal
import subprocess
import sys
import time
from urllib.parse import urlsplit


class ClientError(Exception):
    def __init__(self, result, code):
        self.result = result
        self.code = code


def seconds(value):
    number = float(value)
    if not math.isfinite(number) or not 0 < number <= 86400:
        raise argparse.ArgumentTypeError("must be greater than zero and at most 86400 seconds")
    return number


def arguments():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="resource", required=True)
    pr = commands.add_parser("pr").add_subparsers(dest="command", required=True)
    for name in ("status", "wait"):
        command = pr.add_parser(name)
        command.add_argument("number", type=int)
        command.add_argument("--repo", required=True, help="owner/name")
        command.add_argument("--host", required=True, help="forge origin, e.g. https://git.example.org")
        command.add_argument("--json", action="store_true", help="emit one JSON result")
        if name == "wait":
            command.add_argument("--target", choices=("ready", "merged"), required=True)
            command.add_argument("--timeout", type=seconds, required=True, help="total seconds, including requests")
            command.add_argument("--head", help="expected head SHA; otherwise bind to the first response")
    args = parser.parse_args()
    origin = urlsplit(args.host)
    if (origin.scheme not in ("https", "http") or not origin.hostname
            or origin.username or origin.password or origin.path not in ("", "/")
            or origin.query or origin.fragment or any(c.isspace() for c in args.host)):
        parser.error("--host must be an HTTP(S) origin without credentials, path, query or fragment")
    if origin.scheme == "http" and origin.hostname not in ("localhost", "127.0.0.1", "::1"):
        parser.error("HTTP is supported only for a disposable loopback forge")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", args.repo) or any(
            part in (".", "..") for part in args.repo.split("/")):
        parser.error("--repo must be owner/name")
    if args.number <= 0:
        parser.error("number must be positive")
    if getattr(args, "head", None) and not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", args.head):
        parser.error("--head must be a full hexadecimal SHA")
    return args


def request(url, remaining):
    process = subprocess.Popen(
        ["gh", "api", "--method", "GET", "--include", url],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        env={**os.environ, "GH_PROMPT_DISABLED": "1"}, start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=min(30, remaining))
    except (subprocess.TimeoutExpired, KeyboardInterrupt):
        # Include any credential-helper children in timeout/cancellation cleanup.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.communicate()
        raise
    return subprocess.CompletedProcess(process.args, process.returncode, stdout, stderr)


def fetch(url, remaining):
    try:
        response = request(url, remaining)
    except subprocess.TimeoutExpired:
        raise ClientError("transient_error", 1) from None
    except OSError:
        raise ClientError("gh_unavailable", 1) from None
    # gh --include reports the HTTP status without requiring us to print its
    # stderr (which may contain credential-helper diagnostics).
    status = re.search(r"^HTTP/\S+ (\d{3})", response.stdout, re.MULTILINE)
    http = int(status[1]) if status else None
    if http in (401, 403) or response.returncode == 4 or (
            response.returncode and re.search(
                r"gh auth login|GH_TOKEN|not logged|failed to read configuration", response.stderr)):
        raise ClientError("authentication_error", 4)
    if http in (408, 429) or (http and http >= 500) or (response.returncode and http is None):
        raise ClientError("transient_error", 1)
    if response.returncode or http != 200:
        raise ClientError("request_failed", 1)
    try:
        body = re.split(r"\r?\n\r?\n", response.stdout, maxsplit=1)[1]
        workflow = json.loads(body)["workflow"]
        if workflow["schema"] != "pr_workflow/v1":
            raise ValueError()
        for field in ("head_sha", "current_head_sha"):
            if not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", workflow[field]):
                raise ValueError()
        if workflow["outcome"] not in (
                "draft", "checks_pending", "checks_failed", "review_needed", "blocked",
                "ready", "closed", "merged", "head_changed"):
            raise ValueError()
        for field, kind in (("required_checks", list), ("other_checks", list),
                            ("review", dict), ("passport", dict), ("next_action", dict)):
            if not isinstance(workflow[field], kind):
                raise ValueError()
        if not isinstance(workflow["passport"]["blockers"], list):
            raise ValueError()
        return workflow
    except (ValueError, KeyError, IndexError, TypeError):
        raise ClientError("unsupported_response", 1) from None


def emit(args, result, workflow=None, selected=None):
    value = {"result": result, "selected_head_sha": selected, "workflow": workflow}
    if args.json:
        print(json.dumps(value, sort_keys=True))
        return
    print(result)
    if selected:
        print("Selected head: " + selected)
    if workflow:
        print("Head: " + workflow["head_sha"])
        print("Current head: " + workflow["current_head_sha"])
        # Escape terminal controls in server-provided labels and messages.
        def label(value):
            return json.dumps(str(value), ensure_ascii=True)[1:-1]
        for title, checks in (("Checks", workflow["required_checks"]),
                              ("Other checks", workflow["other_checks"])):
            print(title + (":" if checks else ": none"))
            for check in checks:
                state = check.get("state") or check.get("conclusion") or check.get("status")
                print(f"  {label(check.get('name'))}: {label(state)}")
        review = workflow["review"]
        print(f"Review: {review.get('approvals', 0)}/{review.get('required_approvals', 0)} approvals; "
              f"{review.get('changes_requested', 0)} changes requested; "
              f"{review.get('unresolved_threads', 0)} unresolved threads")
        blockers = workflow["passport"]["blockers"]
        print("Blockers:" if blockers else "Blockers: none")
        for blocker in blockers:
            print(f"  {label(blocker.get('code'))}: {label(blocker.get('message'))}")
        print("Next action: " + label(workflow["next_action"].get("label")))


def run(args):
    url = f"{args.host.rstrip('/')}/api/v1/repos/{args.repo}/pulls/{args.number}"
    waiting = args.command == "wait"
    deadline = time.monotonic() + (args.timeout if waiting else 30)
    selected = getattr(args, "head", None)
    workflow = None
    delay = 1
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                emit(args, "timeout", workflow, selected)
                return 3
            try:
                workflow = fetch(url, remaining)
            except ClientError as error:
                if not waiting or error.result != "transient_error":
                    raise
            else:
                if waiting and time.monotonic() >= deadline:
                    emit(args, "timeout", workflow, selected)
                    return 3
                selected = selected or workflow["head_sha"]
                outcome = workflow["outcome"]
                if (outcome == "head_changed" or workflow["head_sha"] != selected
                        or workflow["current_head_sha"] != selected):
                    emit(args, "head_changed", workflow, selected)
                    return 5
                if not waiting:
                    emit(args, outcome, workflow, selected)
                    return 0
                if outcome == args.target:
                    emit(args, "success", workflow, selected)
                    return 0
                if outcome in ("checks_failed", "blocked", "closed", "draft") or (
                        outcome == "merged" and args.target == "ready"):
                    emit(args, outcome, workflow, selected)
                    return 2
            time.sleep(min(delay, max(0, deadline - time.monotonic())))
            delay = min(15, delay * 2)
    except ClientError as error:
        emit(args, error.result, workflow, selected)
        return error.code
    except KeyboardInterrupt:
        emit(args, "cancelled", workflow, selected)
        return 130


def cancel(_signum, _frame):
    raise KeyboardInterrupt()


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, cancel)
    sys.exit(run(arguments()))
